# Prediction-market bot configuration
PAPER_INITIAL_BALANCE=100
# Use coinbase + BTC/USD if Binance returns HTTP 451 (geo-restricted)
SYMBOL=BTC/USD
DATA_PROVIDER=coinbase
DATABASE_URL=sqlite:///./paper_trading.db
LOOP_INTERVAL_SECONDS=10
TIMEFRAME=15m

# Edge engine
MIN_EDGE=0.08
# Fallback only when Kalshi asks are unavailable (0.50 = 50¢ YES)
MARKET_PROB_ABOVE=0.50
CONTRACT_COST=0.50
# Face value per bet ($5 face ⇒ 5 contracts that pay $1 each if correct)
STAKE_NOTIONAL=5
AUTO_BET=true
MIN_SECONDS_TO_BET=20

# Paper profit vault (same habit we'll use live on Kalshi)
# When cash ≥ working bank + trigger, withdraw amount into "put aside".
# Example: $100 bank, +$55 → at $155 withdraw $50 → leave ~$105.
# Auto-vault pauses once put aside reaches VAULT_GOAL.
VAULT_ENABLED=true
VAULT_TRIGGER_PROFIT=55
VAULT_WITHDRAW_AMOUNT=50
VAULT_GOAL=300

# Strike / odds source: kalshi (default) pulls KXBTC15M from Kalshi public API
STRIKE_SOURCE=kalshi
KALSHI_SERIES=KXBTC15M

# Set true once to wipe paper W/L and reset bankroll, then set back to false
# RESET_PAPER_HISTORY=true
# Or run: python main.py --reset-paper

# Optional manual overrides (beat Kalshi when set)
# MANUAL_STRIKE=64737.27
# MARKET_CENTS=55
# MANUAL_STRIKE_FILE=manual_strike.txt
# MARKET_CENTS_FILE=market_cents.txt

# Logging (terminal output is also written here)
LOG_DIR=logs
LOG_FILE=bot.log
# Rotate when bot.log exceeds this size (bytes); keep N backups
# LOG_MAX_BYTES=5242880
# LOG_BACKUP_COUNT=5

# Durable backups (survive Cursor cloud rebuilds)
BACKUP_DIR=/opt/cursor/artifacts/paper-bot-backups
BACKUP_EVERY_SECONDS=300
BACKUP_KEEP=6
CALIBRATION_LOG=logs/calibration.csv
CALIBRATION_EVERY_SECONDS=60
# Telegram "still alive" ping every N seconds (900 = 15 min; 0 = off)
HEARTBEAT_EVERY_SECONDS=900

# Telegram alerts (BotFather token + your chat id)
TELEGRAM_ALERTS=true
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# On start, bot also sends a short recap of the previous paper run.

# Optional: exchange API credentials (not required for public market data)
# API_KEY=
# API_SECRET=

# ---------------------------------------------------------------------------
# Kalshi authenticated API (prep for live next week — NOT used for paper bets)
# Create at: kalshi.com → Account & security → API Keys
# Private key is shown/downloaded ONCE — store outside the repo.
# Smoke test (balance only, no orders):
#   python scripts/check_kalshi_auth.py
# ---------------------------------------------------------------------------
# KALSHI_API_KEY_ID=a952bcbe-ec3b-4b5b-b8f9-11dae589608c
# KALSHI_PRIVATE_KEY_PATH=/home/you/.config/kalshi/prod.key
# Or paste PEM (use \n for newlines on Render):
# KALSHI_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# KALSHI_ENV=prod
# KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
# Demo practice account keys:
# KALSHI_ENV=demo
# KALSHI_API_BASE=https://external-api.demo.kalshi.co/trade-api/v2
#
# LIVE_TRADING stays off until after paper week (Thu/Fri review).
# Hard-gated in code until 2026-07-30 + LIVE_CONFIRM phrase.
# LIVE_TRADING=false
# LIVE_CONFIRM=YES_I_FINISHED_PAPER_WEEK
# Rehearse payloads on top of paper (no real orders):
# LIVE_DRY_RUN=true
# Retries per window after a missed IOC fill. Each retry re-checks the edge
# against the CURRENT ask, so it never chases a price that ran away.
# LIVE_MAX_ATTEMPTS=3
# Bid this many cents above the displayed ask so a 1¢ tick doesn't cost the
# trade. A limit order still pays the best price available, and the bid is
# capped so the edge never falls below MIN_EDGE. 0 disables.
# LIVE_PRICE_TOLERANCE_CENTS=1
